# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=track_sd05
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Prefer this in hosted environments instead of individual PG* values.
DATABASE_URL=

# Ticket expiry rule
TICKET_MISS_LIMIT=6
TICKET_EXPIRY_HOURS=3

# SSE
SSE_HEARTBEAT_SECONDS=25
SSE_CLIENT_FALLBACK_TIMEOUT_SECONDS=75

# Notification channel
NOTIFICATION_PROVIDER=mock
